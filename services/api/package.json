{
  "name": "@app-starter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "eslint .",
    "prebuild": "pnpm --filter @app-starter/schema --filter @app-starter/extension-sdk build && pnpm run prisma:generate",
    "predev": "pnpm run prisma:generate",
    "pretypecheck": "pnpm --filter @app-starter/schema --filter @app-starter/extension-sdk build && pnpm run prisma:generate",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:seed": "prisma db seed",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run build",
    "test": "node --test test/admin-api.guard.test.mjs test/idempotency-key.test.mjs test/identity.test.mjs test/identity-routes.test.mjs test/media.mapper.test.mjs test/pages.mapper.test.mjs test/pages.revalidation.test.mjs test/prisma-error.test.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@app-starter/extension-sdk": "workspace:*",
    "@app-starter/schema": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "jose": "^6.2.9",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "prisma": "^5.20.0",
    "typescript": "^5.6.0"
  }
}

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_starter
REDIS_URL=redis://localhost:6379

# Auth
# Production requires RS256 PEM keys. Local development generates ephemeral keys if empty.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Preview
# Production requires an explicit secret. Local development uses a non-production fallback if empty.
PREVIEW_TOKEN_SECRET=
# Optional during rotation. Keep for at least PREVIEW_TOKEN_TTL_SECONDS after deploying a new secret.
PREVIEW_TOKEN_PREVIOUS_SECRET=
PREVIEW_TOKEN_TTL_SECONDS=3600

# Commerce
COMMERCE_ENABLED=false

# Localization
MULTI_LOCALE_ENABLED=false
DEFAULT_MARKET=us
DEFAULT_LOCALE=en-US
DEFAULT_CURRENCY=USD
FALLBACK_LOCALE=en-US

# Stripe (reserved for Phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
MEDIA_CDN_BASE_URL=https://cdn.example.com
# Comma-separated hostnames or URLs allowed for externally registered media.
# Keep empty to only allow the configured CDN host.
MEDIA_EXTERNAL_URL_HOSTS=
# Optional fallback for non-R2 direct-upload-compatible endpoints.
MEDIA_UPLOAD_BASE_URL=

# Analytics
ANALYTICS_ENABLED=false
# Only set true after a consent mechanism or external CMP has granted analytics consent.
ANALYTICS_CONSENT_GRANTED=false
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=
CLARITY_PROJECT_ID=

# App
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
API_URL=http://localhost:4000
# Do not set VITE_API_URL for local `pnpm dev`.
# The Admin dev server always calls `/api/v1` and Vite proxies it to the API.

# Storefront ISR revalidation
# Set the same secret in the API and Web runtimes.
STOREFRONT_REVALIDATE_SECRET=
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
STOREFRONT_REVALIDATE_TIMEOUT_MS=5000

# Optional publish smoke-test overrides
SMOKE_ADMIN_EMAIL=admin@example.com
SMOKE_ADMIN_PASSWORD=ChangeMe123!
SMOKE_TENANT_SLUG=default
SMOKE_REQUIRE_REVALIDATION=true
SMOKE_REPORT_PATH=

# Database
# Production DATABASE_URL and REDIS_URL must not include leading/trailing whitespace.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_starter
REDIS_URL=redis://localhost:6379

# Auth
# Production requires RS256 PEM keys. Local development generates ephemeral keys if empty.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Local seed defaults are rejected in production. Set non-default values before production seeding.
# Seed admin email must be valid; password must be 8..128 chars without control characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Preview
# Production requires an explicit secret without leading/trailing whitespace. Local development uses a non-production fallback if empty.
PREVIEW_TOKEN_SECRET=
# Optional during rotation. Keep for at least PREVIEW_TOKEN_TTL_SECONDS after deploying a new secret; do not include leading/trailing whitespace.
PREVIEW_TOKEN_PREVIOUS_SECRET=
# Accepted range: 1..3600 seconds. Invalid or longer values fall back to 3600.
PREVIEW_TOKEN_TTL_SECONDS=3600

# Boolean runtime gates accept true/false, 1/0, yes/no, or on/off.
# Misspelled values fail instead of silently changing feature gates.

# Commerce
COMMERCE_ENABLED=false

# Localization
MULTI_LOCALE_ENABLED=false
DEFAULT_MARKET=us
DEFAULT_LOCALE=en-US
DEFAULT_CURRENCY=USD
FALLBACK_LOCALE=en-US

# Stripe (reserved for Phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2
# Account ID must be a DNS-safe label; bucket must be 3..63 chars using letters, numbers, dots, or hyphens.
# Credentials and region must not contain whitespace or control characters.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
# Replace this placeholder with your real public CDN origin or directory prefix before production smoke.
# Do not point MEDIA_CDN_BASE_URL at a concrete file URL.
# example/test/invalid/local hosts are rejected by production CDN checks.
MEDIA_CDN_BASE_URL=https://cdn.example.com
# Comma-separated hostnames or URLs allowed for externally registered media.
# Keep empty to only allow the configured CDN host.
MEDIA_EXTERNAL_URL_HOSTS=
# Optional fallback for non-R2 direct-upload-compatible endpoints.
MEDIA_UPLOAD_BASE_URL=

# Analytics
ANALYTICS_ENABLED=false
# Only set true after a consent mechanism or external CMP has granted analytics consent.
ANALYTICS_CONSENT_GRANTED=false
# Provider IDs must match the documented vendor format exactly, stay within 64 characters,
# and avoid leading/trailing whitespace or control characters.
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=
CLARITY_PROJECT_ID=

# App
# Production runtimes and smoke URL config reject leading/trailing whitespace.
# API_URL may be an origin or /api/v1; WEB_URL and ADMIN_URL must be origins.
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
API_URL=http://localhost:4000
# Do not set VITE_API_URL for local `pnpm dev`.
# The Admin dev server always calls `/api/v1` and Vite proxies it to the API.
# For Admin production builds, VITE_API_URL / VITE_WEB_URL can override the
# public API and storefront URLs. If left empty, Admin falls back to API_URL and
# WEB_URL above.
VITE_API_URL=
VITE_WEB_URL=

# Storefront ISR revalidation
# Set the same secret in the API and Web runtimes. Leading/trailing whitespace is rejected.
STOREFRONT_REVALIDATE_SECRET=
# Use the storefront origin or exact /api/revalidate URL without leading/trailing whitespace.
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Accepted range: 1..30000 ms. Invalid or longer values fall back to 5000.
STOREFRONT_REVALIDATE_TIMEOUT_MS=5000

# Optional publish smoke-test overrides
# Smoke login inputs are validated before requests: email must be valid, password 8..128 chars,
# and tenant slug must be a lowercase DNS-safe label without leading/trailing hyphens.
SMOKE_ADMIN_EMAIL=admin@example.com
SMOKE_ADMIN_PASSWORD=ChangeMe123!
SMOKE_TENANT_SLUG=default
SMOKE_PAGE_SLUG=
SMOKE_LOCALE=en-US
SMOKE_MARKET=us
SMOKE_REQUIRE_ADMIN_APP=false
SMOKE_REQUIRE_R2_UPLOAD=false
SMOKE_REQUIRE_REVALIDATION=true
SMOKE_RETRY_ATTEMPTS=8
SMOKE_RETRY_DELAY_MS=1000
SMOKE_REPORT_PATH=
